# Runtime
NODE_ENV=development
PORT=5000

# All feature routes are mounted under this prefix
API_PREFIX=/api/v1

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/wishbox

# CORS: "*" to allow everything, or a comma-separated list of origins
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Logging: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug

# Number of trusted proxy hops in front of the app (0 when running locally)
TRUST_PROXY=0

# --- Authentication / JWT --------------------------------------------------
# Both secrets must be at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-string
JWT_REFRESH_EXPIRES_IN=30d
JWT_ISSUER=wishbox
# Devices that can stay signed in at once
AUTH_MAX_SESSIONS=5

# --- OTP -------------------------------------------------------------------
# How long a code stays valid, and how many digits
OTP_TTL_SECONDS=300
# Wrong guesses allowed before the code is burned
OTP_MAX_ATTEMPTS=5
# Matches the countdown in the storefront login modal
OTP_RESEND_COOLDOWN_SECONDS=30
# Development shortcut: include the code in the API response.
# Boot fails if this is true while NODE_ENV=production.
OTP_DEBUG_RETURN_CODE=false

# --- Login code delivery: Wishbox's own WhatsApp gateway -------------------
# The gateway is the only transport, so SMS_API_TOKEN below is required.
SMS_API_URL=https://whatsapp-services-8t87.onrender.com/api/messaging/messages/send
# Bearer token for the gateway.
SMS_API_TOKEN=
# Template variable that carries the OTP code. It must match the placeholder
# name in the approved template.
SMS_API_VARIABLES_KEY=otpdev
SMS_OTP_TEMPLATE_ID=6ac4b0ea957ea5b2decee9ee
SMS_BOOKING_TEMPLATE_ID=6aad0af6fdcd1a027b9e4389
# Optional: admin copy of the booking template. Blank falls back to the booking one.
SMS_ADMIN_TEMPLATE_ID=
# Optional: bookings can go to a different gateway instance.
SMS_BOOKING_API_URL=
# Every gateway template carries a header image, so one is always sent.
SMS_MEDIA_URL=https://res.cloudinary.com/dftt4ow6q/image/upload/v1789112613/fmxa9igwfibetwuc5pr8.jpg
# The gateway is on a free tier and can cold-start for 30s+.
SMS_TIMEOUT_MS=30000
SMS_MAX_ATTEMPTS=2
